# Copy to .env and fill in.

# Classifier backend: "jev" or "mock".
# "mock" runs the whole pipeline with no network and no API key — use it for
# development and tests.
CLASSIFIER_BACKEND=mock

# Required only when CLASSIFIER_BACKEND=jev
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_BASE_URL=https://api.typesafe.ai

# Translate Arabic notes to English before classifying them.
# Leave false until you have measured how Jev does on Arabic notes directly —
# this adds a second provider to the path and one call per unique note.
TRANSLATE_NOTES=false
OPENROUTER_API_KEY=
# Any OpenRouter model id. Pick a cheap one that is good at Arabic; see
# https://openrouter.ai/models
OPENROUTER_MODEL=openai/gpt-4o-mini

# Below this confidence a transaction is queued for the user to confirm
# instead of being auto-categorised.
CONFIDENCE_THRESHOLD=0.70

DATABASE_URL=sqlite:///./masroufi.db

# Shelf life depends on how hot it actually is. Open-Meteo needs no API key.
# Off by default: with it off, each item's static shelf-life label decides which
# shopping list it lands on, which is the behaviour from before this existed.
WEATHER_ENABLED=false
LATITUDE=31.5017
LONGITUDE=34.4668

# LPG burn rates in kg per hour, per burner. Averages over unknown stoves and
# pots — correct them if you know your own cylinder.
BURNER_KG_PER_HOUR=0.25
SIMMER_KG_PER_HOUR=0.10
